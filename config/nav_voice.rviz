Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Map
    Alpha: 1
    Color Scheme: map
    Draw Behind: true
    Enabled: true
    Name: Map
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
    Value: true
  - Class: rviz_default_plugins/RobotModel
    Description Source: Topic
    Description Topic:
      Value: /robot_description
    Enabled: true
    Name: RobotModel
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/LaserScan
    Color: 255; 80; 0
    Color Transformer: FlatColor
    Enabled: true
    Name: LaserScan
    Style: Points
    Topic:
      Depth: 1
      Reliability Policy: Best Effort
      Value: /scan_nav
    Use Fixed Frame: true
    Size (Pixels): 1
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/Path
    Color: 40; 120; 255
    Enabled: true
    Name: Global Plan
    Topic:
      Value: /plan
    Value: true
  - Alpha: 1
    Class: rviz_default_plugins/Path
    Color: 0; 220; 80
    Enabled: true
    Name: Local Plan
    Topic:
      Value: /local_plan
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Semantic regions
    Enabled: true
    Value: true
    Topic:
      Value: /semantic_regions
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/Marker
    Name: Waypoint order
    Enabled: true
    Value: true
    Topic:
      Value: /voice_nav/route
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 5
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
  - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown View
      Scale: 28
      Target Frame: map
      X: 0.0
      Y: 0
    Saved: null
Window Geometry:
  Width: 1280
  Height: 850
  X: 100
  Y: 80
